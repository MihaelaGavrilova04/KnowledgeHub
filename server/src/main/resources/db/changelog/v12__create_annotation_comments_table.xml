<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="12" author="knowledgehub">
        <createTable tableName="annotation_comments">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="annotation_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_ac_annotation"
                             references="annotations(id)"
                             deleteCascade="true"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_ac_user"
                             references="users(id)"
                             deleteCascade="true"/>
            </column>
            <column name="parent_id" type="UUID">
                <constraints foreignKeyName="fk_ac_parent"
                             references="annotation_comments(id)"
                             deleteCascade="true"/>
            </column>
            <column name="comment_text" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="annotation_comments" indexName="idx_ac_annotation">
            <column name="annotation_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
